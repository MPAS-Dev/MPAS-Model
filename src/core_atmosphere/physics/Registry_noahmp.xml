<!-- ========================================================================================================= -->
<!-- ARRAYS SPECIFIC TO NOAHMP LAND SURFACE SCHEME:                                                            -->
<!-- ========================================================================================================= -->

 <dims>

      <dim name="nSoilComps" definition="8"
                description="The number of soil textures as needed as input in the NOAH-MP land surface model"/>

      <dim name="nSnowLevels" definition="3"
                description="The number of snow layers used by the NOAHMP land-surface scheme"/>

      <dim name="nzSnowLevels" definition="nSoilLevels+nSnowLevels"
                description="The number of snow+soil layers used by the NOAHMP land-surface scheme"/>

      <dim name="nCrops" definition="5"
                description="The number of crop types as needed as input in the NOAH-MP land surface model"/>

      <dim name="nRads" definition="2"
                description="The number of shortwave band as needed as input in the NOAH-MP land surface model"/>

 </dims>


 <var_struct name="sfc_input" time_levs="1">

      <var name="soilcomp" type="real" dimensions="nSoilComps nCells" units="unitless"
                description="soil composition needed as input in the NOAH-MP land surface model"
                packages="sf_noahmp_in"/>

      <var name="soilcl1" type="real" dimensions="nCells" units="unitless"
                description="soil texture class level 1 needed as input for the NOAH-MP land surface model"
                packages="sf_noahmp_in"/>

      <var name="soilcl2" type="real" dimensions="nCells" units="unitless"
                description="soil texture class level 2 needed as input for the NOAH-MP land surface model"
                packages="sf_noahmp_in"/>

      <var name="soilcl3" type="real" dimensions="nCells" units="unitless"
                description="soil texture class level 3 needed as input for the NOAH-MP land surface model"
                packages="sf_noahmp_in"/>

      <var name="soilcl4" type="real" dimensions="nCells" units="unitless"
                description="soil texture class level 4 needed as input for the NOAH-MP land surface model"
                packages="sf_noahmp_in"/>

      <var name="croptype" type="real" dimensions="nCrops nCells" units="unitless"
                description="fraction of ncrop types needed as input for the NOAH-MP land surface model"
                packages="sf_noahmp_in"/>

      <var name="fdepthxy" type="real" dimensions="nCells" units="m"
                description="f factor for MMF groundwater needed as input for the NOAH-MP land surface model"
                packages="sf_noahmp_in"/>
                        
      <var name="rechclim" type="real" dimensions="nCells" units="mm"
                description="recharge climatology for MMF groundwater needed as input for the NOAH-MP land surface model"
                packages="sf_noahmp_in"/>
                        
      <var name="eqzwt" type="real" dimensions="nCells" units="m"
                description="climatology water table for MMF groundwater needed as input for the NOAH-MP land surface model"
                packages="sf_noahmp_in"/>
                        
      <var name="riverbedxy" type="real" dimensions="nCells" units="m"
                description="riverbed elevation for MMF groundwater needed as input for the NOAH-MP land surface model"
                packages="sf_noahmp_in"/>

      <var name="irfract" type="real" dimensions="nCells" units="m"
                description="total irrigation fraction needed as input for the NOAH-MP land surface model"
                packages="sf_noahmp_in"/>

      <var name="sifract" type="real" dimensions="nCells" units="m"
                description="sprinkler irrigation fraction needed as input for the NOAH-MP land surface model"
                packages="sf_noahmp_in"/>

      <var name="mifract" type="real" dimensions="nCells" units="m"
                description="micro irrigation fraction needed as input for the NOAH-MP land surface model"
                packages="sf_noahmp_in"/>

      <var name="fifract" type="real" dimensions="nCells" units="m"
                description="flood irrigation fraction needed as input for the NOAH-MP land surface model"
                packages="sf_noahmp_in"/>

      <var name="planting" type="real" dimensions="nCells" units="day"
                description="planting date needed as input for the NOAH-MP land surface model"
                packages="sf_noahmp_in"/>
      
      <var name="harvest" type="real" dimensions="nCells" units="day"
                description="harvest date needed as input for the NOAH-MP land surface model"
                packages="sf_noahmp_in"/>
      
      <var name="season_gdd" type="real" dimensions="nCells" units="K"
                description="total growing degree day needed as input for the NOAH-MP land surface model"
                packages="sf_noahmp_in"/>
      
      <var name="td_fraction" type="real" dimensions="nCells" units="fraction"
                description="tile drainage fraction needed as input for the NOAH-MP land surface model"
                packages="sf_noahmp_in"/>

 </var_struct>


 <nml_record name="physics_lsm_noahmp" in_defaults="true">

      <nml_option name="config_noahmp_iopt_dveg" type="integer" default_value="4"
           units="-"
           description="option for dynamic vegetation"
           possible_values="1 to 6"/>

      <nml_option name="config_noahmp_iopt_crs" type="integer" default_value="1"
           units="-"
           description="option for canopy stomatal resistance"
           possible_values="1 to 2"/>

      <nml_option name="config_noahmp_iopt_btr" type="integer" default_value="1"
           units="-"
           description="option for soil moisture factor in stomatal resistance"
           possible_values="1 to 3"/>

      <nml_option name="config_noahmp_iopt_runsrf" type="integer" default_value="3"
           units="-"
           description="option for surface runoff"
           possible_values="1 to 8"/>

      <nml_option name="config_noahmp_iopt_runsub" type="integer" default_value="3"
           units="-"
           description="option for sub-surface option"
           possible_values="1 to 8"/>
 
      <nml_option name="config_noahmp_iopt_sfc" type="integer" default_value="1"
           units="-"
           description="option for surface drag"
           possible_values="1 to 2"/>

      <nml_option name="config_noahmp_iopt_frz" type="integer" default_value="1"
           units="-"
           description="option for supercooled water"
           possible_values="1 to 2"/>

      <nml_option name="config_noahmp_iopt_inf" type="integer" default_value="1"
           units="-"
           description="option for frozen soil"
           possible_values="1 to 2"/>

      <nml_option name="config_noahmp_iopt_rad" type="integer" default_value="3"
           units="-"
           description="option for canopy radiative transfer"
           possible_values="1 to 3"/>

      <nml_option name="config_noahmp_iopt_alb" type="integer" default_value="1"
           units="-"
           description="option for snow albedo"
           possible_values="1 to 3"/>

      <nml_option name="config_noahmp_iopt_snf" type="integer" default_value="1"
           units="-"
           description="option for rain-snow partitioning"
           possible_values="1 to 5"/>

      <nml_option name="config_noahmp_iopt_tksno" type="integer" default_value="1"
           units="-"
           description="option for snow thermal conductivity"
           possible_values="1 to 5"/>

      <nml_option name="config_noahmp_iopt_tbot" type="integer" default_value="2"
           units="-"
           description="option for lower boundary of soil temperature"
           possible_values="1 to 2"/>

      <nml_option name="config_noahmp_iopt_stc" type="integer" default_value="3"
           units="-"
           description="option for soil or snow temperature time scheme"
           possible_values="1 to 3"/>

      <nml_option name="config_noahmp_iopt_gla" type="integer" default_value="1"
           units="-"
           description="option for glacier ice phase change treatment"
           possible_values="1 to 2"/>

      <nml_option name="config_noahmp_iopt_rsf" type="integer" default_value="4"
           units="-"
           description="option for soil evaporation surface resistance"
           possible_values="1 to 4"/>

      <nml_option name="config_noahmp_iopt_soil" type="integer" default_value="1"
           units="-"
           description="option for soil data"
           possible_values="1 to 4"/>

      <nml_option name="config_noahmp_iopt_pedo" type="integer" default_value="1"
           units="-"
           description="option for pedo-transfer function for soil property"
           possible_values="only 1"/>

      <nml_option name="config_noahmp_iopt_crop" type="integer" default_value="0"
           units="-"
           description="option for crop model"
           possible_values="0 to 1"/>

      <nml_option name="config_noahmp_iopt_irr" type="integer" default_value="0"
           units="-"
           description="option for irrigation trigger"
           possible_values="0 to 3"/>

      <nml_option name="config_noahmp_iopt_irrm" type="integer" default_value="0"
           units="-"
           description="option for irrigaton method"
           possible_values="0 to 3"/>

      <nml_option name="config_noahmp_iopt_infdv" type="integer" default_value="1"
           units=" "
           description="option for infiltration in dynamic VIC runoff scheme"
           possible_values="1 to 3"/>

      <nml_option name="config_noahmp_iopt_tdrn" type="integer" default_value="0"
           units="-"
           description="option for tile drainage"
           possible_values="0 to 2"/>

      <nml_option name="config_noahmp_iopt_compact" type="integer" default_value="2"
           units="-"
           description="option for snow compaction"
           possible_values="1 to 2"/>

      <nml_option name="config_noahmp_iopt_scf" type="integer" default_value="1"
           units="-"
           description="option for ground snow cover fraction"
           possible_values="1 to 2"/>

      <nml_option name="config_noahmp_iopt_wetland" type="integer" default_value="0"
           units="-"
           description="option for wetland scheme"
           possible_values="0 to 2"/>

      <nml_option name="config_noahmp_iopt_snicar_bnd" type="integer" default_value="1"
           units="-"
           description="option for SNICAR snow albedo scheme band number"
           possible_values="1 to 2"/>

      <nml_option name="config_noahmp_iopt_snicar_spec" type="integer" default_value="1"
           units="-"
           description="option for SNICAR snow albedo scheme solar spectrum type"
           possible_values="1 to 6"/>

      <nml_option name="config_noahmp_iopt_snicar_snwopts" type="integer" default_value="3"
           units="-"
           description="option for SNICAR snow albedo scheme snow optics"
           possible_values="1 to 3"/>

      <nml_option name="config_noahmp_iopt_snicar_dstopts" type="integer" default_value="1"
           units="-"
           description="option for SNICAR snow albedo scheme dust optics"
           possible_values="1 to 3"/>

      <nml_option name="config_noahmp_iopt_snicar_rt" type="integer" default_value="2"
           units="-"
           description="option for SNICAR snow albedo scheme radiative transfer solver"
           possible_values="1 to 2"/>

      <nml_option name="config_noahmp_iopt_snicar_shp" type="integer" default_value="3"
           units="-"
           description="option for SNICAR snow albedo scheme snow grain shape"
           possible_values="1 to 4"/>

      <nml_option name="config_noahmp_iopt_snicar_aer" type="logical" default_value="false"
           units="-"
           description="option for SNICAR snow albedo scheme with aerosol impact"
           possible_values=".true. or .false."/>

      <nml_option name="config_noahmp_iopt_snicar_bcmix" type="logical" default_value="false"
           units="-"
           description="option for SNICAR snow albedo scheme with bc-snow internal mixing"
           possible_values=".true. or .false."/>

      <nml_option name="config_noahmp_iopt_snicar_dstmix" type="logical" default_value="false"
           units="-"
           description="option for SNICAR snow albedo scheme with dust-snow internal mixing"
           possible_values=".true. or .false."/>

      <nml_option name="config_noahmp_iopt_snicar_oc" type="logical" default_value="false"
           units="-"
           description="option for SNICAR snow albedo scheme with organic carbon"
           possible_values=".true. or .false."/>

      <nml_option name="config_noahmp_iopt_snicar_tbl" type="logical" default_value="true"
           units="-"
           description="option for SNICAR snow albedo scheme using table aerosol deposition"
           possible_values=".true. or .false."/>

      <nml_option name="config_noahmp_soil_dt" type="real" default_value="0"
           units="-"
           description="Noah-MP soil process timestep (seconds)"
           possible_values="0 or N * dt_mpas"/>

 </nml_record>


